{
  "name": "neon",
  "tokens": {
    "color.bg": "#0a0a12",
    "color.neon": "#00f0ff",
    "color.neon2": "#ff2bd6",
    "color.text": "#d8fbff"
  },
  "rules": {
    "widget": { "text": { "color": "$color.text", "size": 9 }, "transition": 180, "easing": "ease_out" },
    "panel": {
      "fill": "#0a0a12e6", "radius": 4, "padding": 8,
      "border": { "width": 1, "color": "$color.neon" },
      "shadow": [ { "blur": 14, "color": "#00f0ff88" } ]
    },
    "button": {
      "fill": "#0a0a12", "radius": 3, "padding": [5, 10], "minHeight": 18,
      "border": { "width": 1, "color": "$color.neon" },
      "shadow": [ { "blur": 6, "color": "#00f0ff55" } ],
      "states": {
        "hover":   { "fill": "#00f0ff22", "shadow": [ { "blur": 12, "color": "#00f0ffaa" } ] },
        "pressed": { "fill": "#00f0ff44" },
        "focused": { "border": { "width": 2, "color": "$color.neon2" }, "shadow": [ { "blur": 12, "color": "#ff2bd6aa" } ] }
      }
    },
    "button.primary": { "border": { "width": 1, "color": "$color.neon2" }, "shadow": [ { "blur": 8, "color": "#ff2bd688" } ] },
    "toggle": { "fill": "#0a0a12", "radius": 3, "minWidth": 24, "minHeight": 12,
      "border": { "width": 1, "color": "$color.neon" }, "states": { "active": { "fill": "#00f0ff55", "shadow": [ { "blur": 8, "color": "#00f0ffaa" } ] } } },
    "toggle.knob": { "fill": "$color.neon", "radius": 2 },
    "slider": { "fill": "#0a0a12", "radius": 2, "minHeight": 6, "border": { "width": 1, "color": "#00f0ff88" } },
    "slider.fill": { "fill": "$color.neon", "radius": 2, "shadow": [ { "blur": 8, "color": "#00f0ffaa" } ] },
    "slider.knob": { "fill": "$color.neon2", "radius": 2, "shadow": [ { "blur": 8, "color": "#ff2bd6aa" } ] },
    "textfield": { "fill": "#05050a", "radius": 3, "padding": [4, 6], "minHeight": 16,
      "border": { "width": 1, "color": "#00f0ff88" }, "states": { "focused": { "border": { "width": 1, "color": "$color.neon2" } } } },
    "progress": { "fill": "#0a0a12", "radius": 2, "minHeight": 6, "border": { "width": 1, "color": "#00f0ff88" } },
    "progress.fill": { "fill": "$color.neon", "radius": 2, "shadow": [ { "blur": 8, "color": "#00f0ffaa" } ] },
    "scrollbar": { "fill": "#00f0ff66", "radius": 1 },
    "viewport": { "fill": "#05050a", "radius": 3, "border": { "width": 1, "color": "#00f0ff88" } }
  }
}
